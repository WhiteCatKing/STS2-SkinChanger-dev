<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>JoanofArcIroncladHpwear</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>netcoreapp9.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Joan.RitsuBridge" />
    <None Remove="Joan.RitsuDependencies" />
    <EmbeddedResource Include="Joan.RitsuBridge" LogicalName="Joan.RitsuBridge" />
    <EmbeddedResource Include="Joan.RitsuDependencies" LogicalName="Joan.RitsuDependencies" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="GodotSharp" />
    <Reference Include="0Harmony" />
    <Reference Include="sts2" />
  </ItemGroup>
</Project>