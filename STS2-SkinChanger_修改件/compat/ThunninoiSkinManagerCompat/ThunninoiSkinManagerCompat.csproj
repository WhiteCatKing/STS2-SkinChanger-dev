<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>thunninoiSkinManager</AssemblyName>
    <RootNamespace>thunninoiSkinManager</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameAssemblyDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameAssemblyDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGameAssemblyReferences" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameAssemblyDir)/sts2.dll') or !Exists('$(GameAssemblyDir)/GodotSharp.dll')"
           Text="Game assemblies missing from '$(GameAssemblyDir)'. Pass -p:GameAssemblyDir=&lt;directory containing sts2.dll and GodotSharp.dll&gt;." />
  </Target>
</Project>
